# Copy this file to .env and fill in your real values
MONGODB_URI=mongo db connection url
GEMINI_API_KEY=your_gemini_api_key_here
# Embedding model. Changing it invalidates every stored vector (re-embed all incidents first).
GEMINI_EMBED_MODEL=gemini-embedding-001
# Hypothesis models, tried in order; each retried on 429/503 before falling through.
# See what your key can use: node scripts/list-models.mjs
GEMINI_GEN_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
PORT=5000
